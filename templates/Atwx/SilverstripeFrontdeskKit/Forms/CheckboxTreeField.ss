<div class="fdk-checkbox-tree dropdown w-full" data-fdk-checkbox-tree>
    <script type="application/json" data-fdk-tree-options>$ItemsJSON.RAW</script>
    <button type="button" tabindex="0" class="btn btn-outline btn-sm justify-between w-full font-normal" data-fdk-tree-toggle>
        <span data-fdk-tree-summary></span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div tabindex="0" class="dropdown-content bg-base-100 rounded-box shadow z-50 p-3 mt-1 max-h-80 w-full min-w-64 overflow-y-auto" data-fdk-tree-root></div>
    <input type="hidden" name="$Name.ATT" value="$FieldValue.ATT" data-fdk-tree-input />
</div>
