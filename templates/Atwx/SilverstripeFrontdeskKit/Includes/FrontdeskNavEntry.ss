<% if $Children %><% if $Flat %><li class="fdk-nav-section<% if $ExtraClass %> $ExtraClass<% end_if %>"><span class="menu-title">$Title</span><ul><% loop $Children %><% include Atwx\SilverstripeFrontdeskKit\Includes\FrontdeskNavEntry %><% end_loop %></ul></li><% else %><li<% if $ExtraClass %> class="$ExtraClass"<% end_if %>><details class="fdk-nav-group" data-fdk-nav-group><summary<% if $Active %> class="menu-active"<% end_if %><% if $IconOnly %> title="$Title.ATT"<% end_if %>><% include Atwx\SilverstripeFrontdeskKit\Includes\FrontdeskNavEntryLabel Flat=$Flat %></summary><ul class="fdk-nav-submenu bg-base-100 rounded-box shadow-lg z-50 w-56 p-2"><% loop $Children %><% include Atwx\SilverstripeFrontdeskKit\Includes\FrontdeskNavEntry %><% end_loop %></ul></details></li><% end_if %><% else %><li<% if $ExtraClass %> class="$ExtraClass"<% end_if %>><a href="<% if $OpenSearch %>#fdk-search<% else %>$Link<% end_if %>"<% if $OpenSearch %> data-fdk-search-open role="button" aria-haspopup="dialog"<% end_if %><% if $Active %> class="menu-active" aria-current="page"<% end_if %><% if $IconOnly %> title="$Title.ATT"<% end_if %><% if $External %> target="_blank" rel="noopener"<% end_if %>><% include Atwx\SilverstripeFrontdeskKit\Includes\FrontdeskNavEntryLabel Flat=$Flat %></a></li><% end_if %>
