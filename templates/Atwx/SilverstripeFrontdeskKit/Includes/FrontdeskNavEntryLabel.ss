<% if $Icon %><i data-lucide="$Icon" class="size-5" aria-hidden="true"></i><% end_if %><% if $IconOnly && not $Flat %><span class="sr-only">$Title</span><% else %>$Title<% end_if %><% if $Badge %> <span class="badge badge-sm badge-primary">$Badge</span><% end_if %><% if $BadgeSecondary %> <span class="badge badge-sm badge-neutral fdk-badge-secondary">$BadgeSecondary</span><% end_if %>